{
  "manifest_version": 3,

  "name": "FocusGuard",

  "version": "1.0.0",

  "description": "A browser extension that helps users control digital distractions.",

  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "blocked/blocked.css",
        "blocked/blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}